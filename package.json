{
  "name": "keking",
  "version": "1.0.0",
  "description": "Discord bot boilerplate with discord.js and TypeScript",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "bun src/index.ts",
    "deploy:commands": "bun src/deploy-commands.ts",
    "deploy:clear-commands": "bun src/clear-commands.ts",
    "docker:build": "docker build -t keking-bot .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f bot",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/node": "^25.9.1",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/voice": "^0.19.2",
    "axios": "^1.16.1",
    "bgutils-js": "4",
    "discord-player": "^7.2.0",
    "discord-player-tts": "^1.0.9",
    "discord-player-youtubei": "^3.1.0",
    "discord.js": "^14.26.4",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "genius-lyrics": "^4.4.7",
    "googlevideo": "4",
    "libsodium-wrappers": "^0.8.4",
    "pg": "^8.21.0",
    "simple-ytdl-core": "^1.2.2",
    "youtube-dl-exec": "^3.1.7"
  },
  "trustedDependencies": [
    "youtube-dl-exec"
  ]
}
